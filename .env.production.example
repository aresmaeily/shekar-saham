# ============================================================
# رادار بورس — قالب تنظیمات PRODUCTION (.env.production.example)
# ============================================================
# این فایل فقط placeholder دارد و هیچ مقدار واقعی/محرمیتی در آن نیست.
# استفاده:
#   1) cp .env.production.example .env
#   2) همهٔ مقادیر change-me را با مقادیر قوی واقعی عوض کنید
#      (رمز: حداقل ۱۲ کاراکتر تصادفی؛ Fernet:
#       python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
#   3) chmod 600 .env
# FAIL-CLOSED: اگر همین فایل را بدون تغییر به‌عنوان .env استفاده کنید، اپ
# در راه‌اندازی رد می‌شود (validate_security_configuration مقادیر change-me*
# را در PRIVATE_MODE رد می‌کند و الزامات production را بررسی می‌کند).

# ---------- محیط ----------
# الزامی برای فعال‌شدن بررسی‌های سختگیرانهٔ production
ENV=production

# ---------- داده ----------
# تولید بدون منبع زندهٔ مجاز = mock؛ هیچ مسیری برچسب LIVE نمی‌سازد
DATA_SOURCE=mock
POLL_SECONDS=30
REQUEST_TIMEOUT=12
DATA_STALE_AFTER_SEC=300
# کلید منبع زنده فقط با مجوز صریح مالک و قاعدهٔ Two-Key؛ placeholder است،
# تا وقتی مالک مجوز نداده خالی بماند
# BRSAPI_KEY=change-me-brsapi-key-owner-gated

# ---------- حالت خصوصی (الزامی production) ----------
# بدون PRIVATE_MODE=1 یا API_KEY، راه‌اندازی production رد می‌شود
PRIVATE_MODE=1
# رمز ورود مالک — این مقدار placeholder است و باید عوض شود
PRIVATE_PASSWORD=change-me-strong-password
# کلید API برای اسکریپت/اتوماسیون — این مقدار placeholder است و باید عوض شود
API_KEY=change-me-api-key

# ---------- رمزنگاری توکن‌های اعلان ----------
# production به FERNET_KEY پایدار یا API_KEY نیاز دارد؛ بدون آن کلید موقت است
# و پس از ری‌استارت توکن‌های ذخیره‌شده قابل رمزگشایی نیستند
FERNET_KEY=change-me-generate-with-fernet

# ---------- امنیت نشست ----------
# الزامی production: کوکی نشست فقط روی HTTPS
COOKIE_SECURE=1

# ---------- امنیت شبکه ----------
# =1 فقط وقتی پشت پروکسی معکوس معتبر (Nginx/Caddy) هستید؛ در غیر این صورت
# X-Forwarded-For قابل جعل است و rate limit دور زده می‌شود
TRUST_PROXY=0
# فقط مبدأ واقعی خودتان؛ ستاره ممنوع
CORS_ORIGINS=https://change-me-your-domain.example

# ---------- گیت‌های حکمرانی (هرگز تغییر نکنید) ----------
# AI-2 مرحلهٔ دوم تحلیل: خاموش مالک-گیت؛ فعال‌سازی فقط با تصمیم صریح مالک
AI2_ENABLED=0
# زمان‌بند اجرای خودکار: خاموش؛ هیچ کاری بدون راه‌اندازی صریح اجرا نمی‌شود
SCHEDULER_ENABLED=0
# اعلان روی دادهٔ شبیه‌سازی‌شده ممنوع
NOTIFY_ALLOW_SYNTHETIC=0

# ---------- اعلان‌ها (اختیاری) ----------
# TELEGRAM_BOT_TOKEN=
# BALE_BOT_TOKEN=

# ---------- AI provider (اختیاری؛ هرگز کلید واقعی در گیت کامیت نکنید) ----------
AI_PROVIDER=fallback
# کلید بدون AI_EXECUTE=1 هیچ تماس شبکه‌ای نمی‌زند؛ موفقیت = LIVE نیست
# AI_API_KEY=change-me-ai-key-if-used

# ---------- دیسک ----------
# مسیر دادهٔ پایدار (در Docker با volume ./data:/app/data نگه داشته می‌شود)
# RADAR_DATA_DIR=/app/data
