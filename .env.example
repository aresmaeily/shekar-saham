# ===== رادار بورس — نمونه تنظیمات (.env) =====
# این فایل را کپی کنید به .env و مقادیر را برای محیط خود تنظیم کنید.

# ---------- داده ----------
DATA_SOURCE=auto              # mock | tsetmc | brsapi | auto
POLL_SECONDS=30
REQUEST_TIMEOUT=12
TSETMC_BASE=https://cdn.tsetmc.com
DATA_STALE_AFTER_SEC=300       # stale threshold for data_trust freshness
DATA_CLOCK_SKEW_TOLERANCE_SEC=0
# BRSAPI_KEY=your_key_here

# ---------- حالت خصوصی (فقط مالک) ----------
# همه خروجی‌ها قفل می‌شوند؛ بازدیدکننده باید با رمز وارد شود
PRIVATE_MODE=1
# رمز ورود (حداقل ۱۲ کاراکتر، ترجیحاً تصادفی)
PRIVATE_PASSWORD=change-me-strong-password
# کلید API برای اسکریپت/اتوماسیون (اختیاری اما توصیه‌شده)
API_KEY=change-me-api-key

# ---------- رمزنگاری توکن‌های تلگرام/بله ----------
# ⚠️ خیلی مهم: بدون این، توکن‌های ذخیره‌شده بعد از ری‌استارت قابل رمزگشایی نیستند.
# تولید: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---------- امنیت نشست ----------
# کوکی نشست فقط روی HTTPS ارسال شود (در استقرار واقعی =1)
COOKIE_SECURE=0

# ---------- امنیت شبکه ----------
# فقط وقتی پشت پروکسی معکوس مطمئن (Nginx/Caddy) هستید =1 بگذارید.
# در غیر این صورت X-Forwarded-For قابل جعل است و rate limit دور می‌زند.
TRUST_PROXY=0

# ---------- اعلان‌ها ----------
# TELEGRAM_BOT_TOKEN=
# BALE_BOT_TOKEN=

# ---------- AI provider (optional, never put keys in git) ----------
# AI_PROVIDER=fallback          # fallback | openai | anthropic | groq | gemini | azure
# AI_MODEL=
# AI_BASE_URL=                  # optional HTTPS override; required for azure
# AI_TIMEOUT_SEC=20
# AI_RETRY_MAX=0
# AI_EXECUTE=0                  # 1 = allow HTTPS transport when a server-side key is set
# AI_API_KEY=                   # never accepted from the client; never commit a real key
# A key without AI_EXECUTE=1 does not call the network. Success is not market LIVE.

# ---------- CORS (برای استقرار) ----------
# CORS_ORIGINS=https://yourdomain.com
