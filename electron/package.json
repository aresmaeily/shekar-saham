{
  "name": "radar-bourse-desktop",
  "version": "0.9.0",
  "description": "رادار بورس - نسخه دسکتاپ ویندوز - بهتر از فراز",
  "main": "main.js",
  "author": "RADAR BOURSE Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:all": "electron-builder --win --mac --linux"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.radarbourse.desktop",
    "productName": "رادار بورس",
    "files": ["main.js"],
    "win": {
      "target": "nsis",
      "icon": "../frontend/favicon.svg"
    },
    "directories": {
      "output": "dist"
    }
  }
}
